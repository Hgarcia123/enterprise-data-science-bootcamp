# .env.example: the list of settings this project needs, WITHOUT the real values.
# This file IS in Git. Copy it to a file called .env and fill in your own values.
# The .env file is NOT in Git (see .gitignore), so secrets never reach GitHub.

# A secret. Every person has their own. Nothing after the = sign here.
API_KEY=

# A setting that can differ from one computer to another.
RAW_DATA_FILE=lending-club.csv
